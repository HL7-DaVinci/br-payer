        "item": [
          {
            "linkId": "2.1",
            "text": "What is the primary pain diagnosis?",
            "answer": [
              {
                "valueString": "Chronic low back pain"
              }
            ]
          },
          {
            "linkId": "2.2",
            "text": "Pain severity (0-10 scale)",
            "answer": [
              {
                "valueInteger": 7
              }
            ]
          },
          {
            "linkId": "2.3",
            "text": "Duration of pain condition",
            "answer": [
              {
                "valueCoding": {
                  "code": "chronic",
                  "display": "Chronic (> 6 months)"
                }
              }
            ]
          },
          {
            "linkId": "2.4",
            "text": "Functional impact description",
            "answer": [
              {
                "valueString": "Unable to perform daily activities, difficulty sleeping, limited mobility"
              }
            ]
          },
          {
            "linkId": "3.1",
            "text": "Non-opioid medications tried",
            "answer": [
              {
                "valueString": "Ibuprofen 800mg TID, Acetaminophen 1000mg QID, Gabapentin 300mg TID"
              }
            ]
          },
          {
            "linkId": "3.3",
            "text": "Reason prior treatments were insufficient",
            "answer": [
              {
                "valueString": "Inadequate pain relief with NSAIDs, gabapentin caused dizziness without benefit"
              }
            ]
          },
          {
            "linkId": "4.1",
            "text": "Is the patient opioid-naive?",
            "answer": [
              {
                "valueBoolean": true
              }
            ]
          },
          {
            "linkId": "4.3",
            "text": "History of substance use disorder",
            "answer": [
              {
                "valueBoolean": false
              }
            ]
          },
          {
            "linkId": "4.4",
            "text": "Is the formulation extended-release?",
            "answer": [
              {
                "valueBoolean": false
              }
            ]
          },
          {
            "linkId": "5.1",
            "text": "Medication being prescribed",
            "answer": [
              {
                "valueString": "Oxycodone Hydrochloride 5 MG Oral Tablet"
              }
            ]
          },
          {
            "linkId": "5.2",
            "text": "Requested days supply",
            "answer": [
              {
                "valueInteger": 7
              }
            ]
          },
          {
            "linkId": "5.3",
            "text": "Clinical justification for opioid therapy",
            "answer": [
              {
                "valueString": "Failed multiple non-opioid therapies. Severe chronic pain limiting function."
              }
            ]
          },
          {
            "linkId": "5.4",
            "text": "Treatment goals and expected duration",
            "answer": [
              {
                "valueString": "Short-term pain management while pursuing physical therapy. Goal: reduce pain to 4/10 within 2 weeks."
              }
            ]
          },
