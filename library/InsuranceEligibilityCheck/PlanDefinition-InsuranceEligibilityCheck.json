          "kind": "applicability",
          "expression": {
            "language": "text/cql-identifier",
            "expression": "Requires Eligibility Notification"
          }
        }
      ],
      "dynamicValue": [
        {
          "path": "action.title",
          "expression": {
            "language": "text/cql-identifier",
            "expression": "Get Summary"
          }
        },
        {
          "path": "action.description",
          "expression": {
            "language": "text/cql-identifier",
            "expression": "Get Detail"
          }
        },
        {
          "path": "extension",
          "expression": {
            "language": "text/cql-identifier",
            "expression": "Coverage Info Extension"
          }
        }
      ]
    }
  ]
