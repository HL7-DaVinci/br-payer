  "version": "1.0.0",
  "name": "InsuranceEligibilityCheck",
  "title": "Insurance Eligibility Check at Encounter Start",
  "status": "active",
  "description": "Verifies insurance eligibility when an encounter begins and alerts for coverage expiration or special encounter types.",
  "useContext": [
    {
      "code": {
        "system": "http://terminology.hl7.org/CodeSystem/usage-context-type",
        "code": "program"
      },
      "valueCodeableConcept": {
