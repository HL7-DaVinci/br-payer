  "action": [
    {
      "id": "safety-warning",
      "title": "Opioid Safety Warning",
      "description": "Warns about drug interactions, high-risk prescribing patterns during order selection",
      "documentation": [
        {
          "type": "documentation",
          "display": "CDC Clinical Practice Guideline for Prescribing Opioids (2022)",
          "url": "https://www.cdc.gov/mmwr/volumes/71/rr/rr7103a1.htm"
        }
      ],
      "trigger": [
        {
          "type": "named-event",
          "name": "order-select"
        }
      ],
      "condition": [
        {
          "kind": "applicability",
          "expression": {
            "language": "text/cql-identifier",
            "expression": "Has Safety Warnings"
          }
        }
      ],
      "dynamicValue": [
        {
          "path": "action.title",
          "expression": {
            "language": "text/cql-identifier",
            "expression": "Warning Summary"
          }
        },
        {
          "path": "action.description",
          "expression": {
            "language": "text/cql-identifier",
            "expression": "Warning Detail"
          }
        },
        {
          "path": "action.priority",
          "expression": {
            "language": "text/cql-identifier",
            "expression": "Warning Indicator"
          }
        }
      ]
    },
    {
      "id": "alternative-suggestion",
      "title": "Non-Opioid Alternative",
      "description": "Suggests non-opioid alternatives for opioid-naive patients",
      "trigger": [
        {
          "type": "named-event",
          "name": "order-select"
        }
      ],
      "condition": [
        {
          "kind": "applicability",
          "expression": {
            "language": "text/cql-identifier",
            "expression": "Has Non Opioid Alternative"
          }
        }
      ],
      "dynamicValue": [
        {
          "path": "action.title",
          "expression": {
            "language": "text/cql-identifier",
            "expression": "Alternative Summary"
          }
        },
        {
          "path": "action.description",
          "expression": {
            "language": "text/cql-identifier",
            "expression": "Alternative Detail"
          }
        }
      ]
    },
    {
      "id": "coverage-info",
      "title": "Opioid Coverage Requirements",
      "description": "Provides coverage determination, prior authorization, and documentation requirements at order signing",
      "documentation": [
        {
          "type": "documentation",
          "display": "Medicare Part D Opioid Policies",
          "url": "https://www.cms.gov/Medicare/Prescription-Drug-Coverage/PrescriptionDrugCovContra/RxUtilization"
