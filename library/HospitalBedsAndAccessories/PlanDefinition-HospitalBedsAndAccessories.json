{
  "resourceType": "PlanDefinition",
  "id": "HospitalBedsAndAccessories",
  "url": "http://example.org/fhir/PlanDefinition/HospitalBedsAndAccessories",
  "version": "1.0.0",
  "name": "HospitalBedsAndAccessories",
  "title": "Hospital Beds and Accessories",
  "status": "active",
  "description": "Hospital Beds and Accessories devices - provides coverage guidance with hook-specific behavior for order-select (alternatives) and order-sign (documentation requirements)",
  "useContext": [
    {
      "code": {
        "system": "http://terminology.hl7.org/CodeSystem/usage-context-type",
        "code": "program"
      },
      "valueCodeableConcept": {
        "coding": [
          {
            "system": "urn:oid:2.16.840.1.113883.6.300",
            "code": "00001"
          },
          {
            "system": "http://hl7.org/fhir/sid/us-npi",
            "code": "1234567893"
          },
          {
            "system": "http://hl7.org/fhir/sid/us-npi",
            "code": "8189991234"
          }
        ]
      }
    },
    {
      "code": {
        "system": "http://terminology.hl7.org/CodeSystem/usage-context-type",
        "code": "focus"
      },
      "valueCodeableConcept": {
        "coding": [
          {
            "system": "http://www.cms.gov/Medicare/Coding/HCPCSReleaseCodeSets",
            "code": "E0250"
          },
          {
            "system": "http://www.cms.gov/Medicare/Coding/HCPCSReleaseCodeSets",
            "code": "E0251"
          }
        ]
      }
    }
  ],
  "library": [
    "http://example.org/fhir/Library/HospitalBedsAndAccessoriesRule"
  ],
  "action": [
    {
      "id": "alternative-suggestion",
      "title": "Alternative Therapy Suggestion",
      "description": "Suggest lower-cost alternatives during order selection",
      "code": [
        {
          "coding": [
            {
              "system": "http://terminology.hl7.org/CodeSystem/cdshooks-card-type",
              "code": "therapy-alternatives-opt",
              "display": "Optional Therapy Alternatives"
            }
          ]
        }
      ],
      "documentation": [
        {
          "type": "documentation",
          "display": "CRD order-select: Early guidance before provider commits to an order"
        }
      ],
      "trigger": [
        {
          "type": "named-event",
          "name": "order-select"
        }
      ],
      "condition": [
        {
          "kind": "applicability",
          "expression": {
            "language": "text/cql-identifier",
            "expression": "Has Lower Cost Alternative"
          }
        }
      ],
      "dynamicValue": [
        {
          "path": "action.title",
          "expression": {
            "language": "text/cql-identifier",
            "expression": "Alternative Summary"
          }
        },
        {
          "path": "action.description",
          "expression": {
            "language": "text/cql-identifier",
            "expression": "Alternative Detail"
          }
        }
      ]
    },
    {
      "id": "coverage-info",
      "title": "Coverage Information",
      "description": "General coverage determination for both hooks",
      "documentation": [
        {
          "type": "documentation",
          "display": "Medicare Hospital Bed Coverage Policy",
          "url": "https://www.cms.gov/medicare-coverage-database/view/lcd.aspx?lcdid=33820"
        }
      ],
      "trigger": [
        {
          "type": "named-event",
          "name": "order-select"
        },
        {
          "type": "named-event",
          "name": "order-sign"
        }
      ],
      "condition": [
        {
          "kind": "applicability",
          "expression": {
            "language": "text/cql-identifier",
            "expression": "Requires Coverage Determination"
          }
        }
      ],
      "dynamicValue": [
        {
          "path": "action.title",
          "expression": {
            "language": "text/cql-identifier",
            "expression": "Get Summary"
          }
        },
        {
          "path": "action.description",
          "expression": {
            "language": "text/cql-identifier",
            "expression": "Get Detail"
          }
        },
        {
          "path": "extension",
          "expression": {
            "language": "text/cql-identifier",
            "expression": "Coverage Info Extension"
          }
        }
      ]
    },
    {
      "id": "informative-guidance",
      "title": "Hospital Bed Documentation Guidance",
      "description": "Non-coverage instructions for hospital bed orders",
      "code": [
        {
          "coding": [
            {
              "system": "http://terminology.hl7.org/CodeSystem/cdshooks-card-type",
              "code": "appropriate-use",
              "display": "Appropriate Use"
            }
          ]
        }
      ],
      "documentation": [
        {
          "type": "documentation",
          "display": "Medicare Hospital Bed Coverage Policy",
          "url": "https://www.cms.gov/medicare-coverage-database/view/lcd.aspx?lcdid=33820"
        }
      ],
      "trigger": [
        {
          "type": "named-event",
          "name": "order-select"
        },
        {
          "type": "named-event",
          "name": "order-sign"
        }
      ],
      "condition": [
        {
          "kind": "applicability",
          "expression": {
            "language": "text/cql-identifier",
            "expression": "Requires Coverage Determination"
          }
        }
      ],
      "dynamicValue": [
        {
          "path": "action.title",
          "expression": {
            "language": "text/cql-identifier",
            "expression": "Info Summary"
          }
        },
        {
          "path": "action.description",
          "expression": {
            "language": "text/cql-identifier",
            "expression": "Info Detail"
          }
        }
      ]
    }
  ]
}
